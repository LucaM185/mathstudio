{
  "name": "mathstudio",
  "productName": "MathStudio",
  "version": "0.1.1",
  "description": "A visual IDE for ManimGL animations",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucaM185/mathstudio.git"
  },
  "author": "MathStudio",
  "license": "AGPL-3.0-only",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && env -u ELECTRON_RUN_AS_NODE electron .",
    "electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "typecheck": "tsc --noEmit",
    "test:engine": "engine/.venv/bin/python engine/tests/test_engine.py --export",
    "test:search": "engine/.venv/bin/python engine/tests/test_search.py",
    "test:gallery": "engine/.venv/bin/python -W ignore engine/tests/test_gallery.py",
    "test:e2e": "vite build && node tests/e2e.mjs",
    "test:e2e3d": "vite build && node tests/e2e3d.mjs",
    "test:projects": "vite build && node tests/projects.mjs",
    "test:globals": "vite build && node tests/globals.mjs",
    "test:morph": "vite build && node tests/morph_timeline.mjs",
    "test:transform": "vite build && node tests/transform_here.mjs",
    "test:hitbox": "vite build && node tests/hitbox.mjs",
    "test:partmove": "vite build && node tests/part_move.mjs",
    "test:pmobject": "engine/.venv/bin/python -W ignore engine/tests/test_project_mobject.py && vite build && node tests/project_mobject.mjs",
    "test:likes": "vite build && node tests/project_likes.mjs",
    "test:trash": "vite build && node tests/project_trash.mjs",
    "test:knobs": "engine/.venv/bin/python -W ignore engine/tests/test_code_knobs.py && vite build && node tests/code_knobs.mjs",
    "test:boot": "vite build && node tests/boot_screen.mjs",
    "dist:linux": "packaging/linux/build.sh",
    "dist:mac": "packaging/mac/build.sh",
    "install:mac": "packaging/mac/build.sh --install",
    "test:linux": "packaging/linux/test.sh",
    "test:settings": "vite build && node tests/settings.mjs",
    "test:camera": "vite build && node tests/camera_track.mjs",
    "test:vieworient": "vite build && node tests/view_orient.mjs",
    "test:rotate": "vite build && node tests/rotate_gizmo.mjs",
    "test:history": "vite build && node tests/project_history.mjs",
    "test:perf": "vite build && node tests/perf_playback.mjs --min-fps 15",
    "test:updates": "vite build && node tests/updates.mjs",
    "release": "npm version patch -m \"Release %s\" && git push --follow-tags",
    "test:linux-update": "packaging/linux/test-update.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@uiw/react-codemirror": "^4.23.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.460.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "zustand": "^4.5.5"
  }
}
